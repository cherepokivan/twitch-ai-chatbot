# Twitch bot account credentials. Create a token with chat:read and chat:edit scopes.
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_BOT_NICK=your_bot_login

# Streamer/channel the bot should join and observe.
TWITCH_CHANNEL=streamer_login

# LLM provider.
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Persona, like a custom streamer bot role.
BOT_PERSONA_NAME=Света
BOT_PERSONA_AGE=22
BOT_PERSONA_ROLE=дружелюбная, немного ироничная AI-подруга стримера; отвечает коротко, живым разговорным русским языком
BOT_PERSONA_EXTRA=

# Features.
READ_CHAT=true
OBSERVE_STREAM=true
OBSERVE_VIDEO=true
OBSERVE_AUDIO=true
TRIGGER_MODE=mention
MIN_SECONDS_BETWEEN_REPLIES=20
REPLY_PROBABILITY=1.0
MAX_REPLY_CHARS=420
