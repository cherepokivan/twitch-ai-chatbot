# Twitch bot account credentials. Create a token with chat:read and chat:edit scopes.
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_CLIENT_SECRET=your_twitch_app_client_secret
TWITCH_BOT_NICK=your_bot_login

# Streamer/channel the bot should join and observe.
TWITCH_CHANNEL=streamer_login

# LLM provider: openai or groq.
LLM_PROVIDER=groq

# OpenAI settings, used when LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Groq settings, used when LLM_PROVIDER=groq.
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=qwen/qwen3-32b
# Vision model watches screenshots and writes stream observations.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Local Vosk speech recognition. Keep false to use Groq/OpenAI Whisper.
VOSK_ENABLED=off
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22

# Persona, like a custom streamer bot role.
BOT_PERSONA_NAME=Света
BOT_PERSONA_AGE=22
BOT_PERSONA_ROLE=дружелюбная, немного ироничная AI-подруга стримера; отвечает коротко, живым разговорным русским языком
BOT_PERSONA_EXTRA=

# Twitch logins that may use admin bot commands like !ai togglechat.
BOT_ADMIN_USERS=Ivan_Cherepok,ivan_cherepok

# Features.
READ_CHAT=true
OBSERVE_STREAM=true
OBSERVE_VIDEO=true
OBSERVE_AUDIO=true
TRIGGER_MODE=mention
MIN_SECONDS_BETWEEN_REPLIES=1
REPLY_PROBABILITY=1.0
MAX_REPLY_CHARS=420
FRAME_INTERVAL_SECONDS=5
AUDIO_INTERVAL_SECONDS=5
LLM_TRUST_ENV=false
STREAMLINK_TRUST_ENV=false
REQUEST_TIMEOUT_SECONDS=30
LOG_TRACEBACKS=false
